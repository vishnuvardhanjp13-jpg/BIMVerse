# Public Stripe Payment Link URLs. These are safe to expose in the website.
NEXT_PUBLIC_STRIPE_BEP_URL=https://buy.stripe.com/replace-with-bep-payment-link
NEXT_PUBLIC_STRIPE_APPENDIX_URL=https://buy.stripe.com/replace-with-appendix-payment-link

# Keep all values below private. Never add real values to source control.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret
RESEND_API_KEY=re_replace_with_resend_api_key
DELIVERY_FROM_EMAIL=downloads@your-verified-domain.com
